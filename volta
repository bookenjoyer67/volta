#!/usr/bin/env bash
# Volta — ebook reader with RSVP speed reading
#
# Dual-mode launcher:
#   Terminal (isatty) → TUI (ratatui, runs in terminal)
#   Desktop (no tty)  → GUI (LÖVE, runs as window)
#   --gui flag        → force GUI mode, disown from terminal
#
# Usage:
#   volta book.epub          # TUI in terminal, GUI from desktop icon
#   volta --gui book.epub    # GUI even from terminal, prompt freed
#
# Path detection (first match wins):
#   1. $VOLTA_HOME — explicit override
#   2. /usr (system install) — if /usr/bin/volta-tui exists
#   3. $HOME/volta — dev/git clone

set -euo pipefail

# ── Path detection ──
if [ -n "${VOLTA_HOME:-}" ]; then
    # Explicit override
    PREFIX="$VOLTA_HOME"
    TUI_BIN="$PREFIX/bin/volta-tui"
    FRONTEND="$PREFIX/share/volta/frontend"
    LIB_PATH="$PREFIX/lib/volta/libvolta_core.so"
    DEV_MODE=0
elif [ -f /usr/bin/volta-tui ]; then
    # System install
    PREFIX=/usr
    TUI_BIN=/usr/bin/volta-tui
    FRONTEND=/usr/share/volta/frontend
    LIB_PATH=/usr/lib/volta/libvolta_core.so
    DEV_MODE=0
else
    # Dev / git clone
    PREFIX="${HOME}/volta"
    TUI_BIN="$PREFIX/target/release/volta-tui"
    FRONTEND="$PREFIX/frontend"
    LIB_PATH="$FRONTEND/libvolta_core.so"
    DEV_MODE=1
fi

# ── Check for --gui flag ──
FORCE_GUI=0
ARGS=()
for arg in "$@"; do
    if [ "$arg" = "--gui" ]; then
        FORCE_GUI=1
    else
        ARGS+=("$arg")
    fi
done
set -- "${ARGS[@]}"

# ── URL download ──
if [[ "${1:-}" == http://* || "${1:-}" == https://* ]]; then
    URL="$1"
    DEST_DIR="${VOLTA_DOWNLOAD_DIR:-$HOME/Downloads}"
    mkdir -p "$DEST_DIR"

    FILENAME=$(basename "$URL" | sed 's/[?#].*//')
    [ -n "$FILENAME" ] || FILENAME="downloaded-book"

    DEST="$DEST_DIR/$FILENAME"
    echo "==> Downloading → $DEST" >&2
    curl -fL --progress-bar -o "$DEST" "$URL" || { echo "Download failed" >&2; exit 1; }

    set -- "$DEST" "${@:2}"
fi

# ── Build if needed (dev mode only) ──
if [ $DEV_MODE -eq 1 ]; then
    NEEDS_BUILD=0
    if [[ ! -f "$TUI_BIN" ]] || [[ ! -f "$LIB_PATH" ]]; then
        NEEDS_BUILD=1
    else
        for src in "$PREFIX/core/src/"*.rs "$PREFIX/core/src/tui/"*.rs; do
            [ -f "$src" ] || continue
            [ "$src" -nt "$TUI_BIN" ] && NEEDS_BUILD=1 && break
        done
    fi

    if [ $NEEDS_BUILD -eq 1 ]; then
        echo "==> Building Volta..." >&2
        cd "$PREFIX"
        ./build.sh || exit 1
    fi
fi

# ── Update bridge.lua .so path if needed ──
BRIDGE_LUA="$FRONTEND/bridge.lua"
if [ -f "$BRIDGE_LUA" ] && grep -q 'local lib_path =' "$BRIDGE_LUA" 2>/dev/null; then
    CURRENT_PATH=$(grep 'local lib_path =' "$BRIDGE_LUA" | head -1 | sed 's/.*"\(.*\)".*/\1/')
    if [[ "$CURRENT_PATH" != "$LIB_PATH" ]]; then
        sed -i "s|local lib_path = \".*\"|local lib_path = \"$LIB_PATH\"|" "$BRIDGE_LUA"
    fi
fi

# ── Dispatch ──
if [ $FORCE_GUI -eq 1 ]; then
    # Explicit --gui: launch LÖVE and disown so terminal is freed
    love "$FRONTEND" "$@" &
    disown
elif [ -t 0 ]; then
    # Running in a terminal (no --gui) → TUI mode
    exec "$TUI_BIN" "$@"
else
    # Running from desktop/launcher (no terminal) → LÖVE GUI mode
    exec love "$FRONTEND" "$@"
fi
